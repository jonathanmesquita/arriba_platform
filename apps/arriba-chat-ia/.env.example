# Modelo de configuração do servidor do app de chat.
# Copie para server/.env (é de lá que o servidor e o Prisma leem):
#   cp .env.example server/.env
# O server/.env NÃO vai para o git. Este modelo vai — e não tem valor de segredo.
# A lista e as regras de cada variável estão em server/src/env.ts: o servidor
# não sobe com configuração incompleta e diz o que falta.

NODE_ENV=development
PORT=3333

# Postgres do docker-compose.yml (só escuta em 127.0.0.1). Outro banco: troque aqui.
DATABASE_URL=postgresql://arriba:arriba_dev@127.0.0.1:5432/arriba_chat_ia

# Segredos — gere, não invente:
#   openssl rand -base64 32   -> ENCRYPTION_KEY (cifra as chaves de API no banco; guarde-a)
#   openssl rand -base64 48   -> JWT_SECRET     (assina o cookie de sessão; 32+ caracteres)
ENCRYPTION_KEY=
JWT_SECRET=
SESSION_TTL_HOURS=12

# Origem do front, para CORS com cookie (separe por vírgula).
CORS_ORIGINS=http://localhost:5173
COOKIE_NAME=arriba_chat_session
# auto = Secure em produção, sem Secure em http://localhost
COOKIE_SECURE=auto

# Quantas mensagens do histórico vão junto a cada chamada ao provedor.
CHAT_HISTORY_LIMIT=20
# Corte por requisição ao provedor, em milissegundos.
PROVIDER_TIMEOUT_MS=120000

# Primeiro administrador — só usado por `npm run db:seed`. Apague a senha depois.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Modelo de configuração do portal de comunicados.
# Copie para .env nesta pasta (apps/comunicados):
#   cp .env.example .env
# O .env NÃO vai para o git. Este modelo vai — e não tem valor de segredo.
# A lista e as regras de cada variável estão em server/src/env.ts: o servidor
# não sobe com configuração incompleta e diz o que falta.

NODE_ENV=development
PORT=3344

# SQLite: um arquivo, sem servidor de banco. Caminho relativo a server/.
DATABASE_URL=file:../dados/comunicados.db
PASTA_DADOS=../dados

# Segredos — gere, não invente:
#   openssl rand -base64 32   -> ENCRYPTION_KEY (cifra a senha do SMTP no banco; guarde-a)
#   openssl rand -base64 48   -> JWT_SECRET     (assina o cookie de sessão; 32+ caracteres)
ENCRYPTION_KEY=
JWT_SECRET=
SESSION_TTL_HOURS=12

CORS_ORIGINS=http://localhost:5273
COOKIE_NAME=comunicados_sessao
# auto = Secure em produção, sem Secure em http://localhost
COOKIE_SECURE=auto

# Teto do corpo JSON, em KB.
MAX_BODY_KB=1024

# 1 = não manda e-mail pela rede: grava cada mensagem como .eml em dados/saida/.
SMTP_MODO_TESTE=1

# Primeiro administrador — só usado por `npm run db:seed`. Apague a senha depois.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOME=
